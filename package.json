{
  "name": "@asana/command-mcp",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "author": "Asana",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "asana-command-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --platform node --target node22 --clean --sourcemap",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src tests scripts",
    "test": "vitest run --exclude 'tests/integration/**'",
    "test:integration": "vitest run tests/integration",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "asana": "3.1.12",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "2.1.2",
    "@types/node": "26.1.1",
    "tsup": "8.5.0",
    "typescript": "5.9.2",
    "vitest": "3.2.7"
  }
}
